# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string. Use the pooled URL with sslmode=require.
# Leave unset locally and the app runs on an embedded Postgres under .data/pglite.
DATABASE_URL=

# Auth is phone + OTP, ours end to end: see src/lib/auth. No third party holds
# the session or the code. The only external dependency is delivering the SMS.

# Razorpay, step 7. Test keys first, live keys only after a one rupee live order.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Observability
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Signs session cookies and keys the OTP hash. Required in production.
#   openssl rand -base64 32
AUTH_SECRET=

# SMS. Without these the code is printed to the server log instead of sent.
#
# Everything here comes from MSG91 once DLT registration is through: register
# the entity with a telecom operator, then a header (the six-letter sender id),
# then the message template. The template text must match what is sent, to the
# character, with the code as the ##otp## variable.
#
# MSG91_TEMPLATE_ID is the fallback used for any language. Set the per-language
# ids only once you have a second template approved; DLT registers one per
# language, so Hindi and English are two registrations.
#
# Check credentials before touching the sign-in screen:
#   npm run sms:test -- +919821340917
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_TEMPLATE_ID_EN=
MSG91_TEMPLATE_ID_HI=
MSG91_SENDER_ID=

# Delivery reports. MSG91's send call answers "accepted", not "delivered" — it
# returns success even for an invalid auth key — so this callback is the only
# way to know a code actually arrived.
#
# Generate a secret, then set the callback URL in the MSG91 dashboard to:
#   https://<your-domain>/api/webhooks/msg91?token=<MSG91_WEBHOOK_SECRET>
#
#   openssl rand -hex 24
#
# MSG91 does not sign these callbacks, so the secret in the URL is the whole
# proof. The endpoint therefore only writes to a log table and grants nothing.
MSG91_WEBHOOK_SECRET=

# Gold plan. Price is a product decision that has not been made.
GOLD_PRICE_PAISE=14900
GOLD_MONTHS=3

# Canonical origin, used by robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=

# MSG91 OTP Widget. Leave blank and sign-in uses the app's own OTP endpoints.
# Fill both and MSG91 sends and checks the code, behind the same Kettle screen.
# Both are sent to the browser by design; a session still requires the server
# to verify the token with MSG91_AUTH_KEY, which stays server-side.
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_WIDGET_TOKEN=
